{
  "name": "@dudousxd/nestjs-notifications-event-emitter",
  "version": "0.4.0",
  "description": "In-process async dispatcher for nestjs-notifications using @nestjs/event-emitter",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-notifications.git",
    "directory": "packages/event-emitter"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/notifications",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-notifications/issues"
  },
  "keywords": [
    "nestjs",
    "notifications",
    "event",
    "emitter"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-notifications-core": ">=0.1.0 <1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/event-emitter": "^2.0.0 || ^3.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-notifications-core": "workspace:^",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/testing": "12.3.2",
    "reflect-metadata": "0.2.2",
    "typescript": "5.9.3"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24"
  }
}
