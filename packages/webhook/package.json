{
  "name": "@dudousxd/nestjs-notifications-webhook",
  "version": "0.7.0",
  "description": "Webhook channel for nestjs-notifications — direct signed POSTs over @nestjs/webhooks' SSRF-guarded transport, or subscription delivery through @nestjs/webhooks",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-notifications.git",
    "directory": "packages/webhook"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/notifications",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-notifications/issues"
  },
  "keywords": [
    "nestjs",
    "notifications",
    "webhook"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-notifications-core": ">=0.1.0 <1.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/webhooks": ">=0.0.4 <0.1.0",
    "@nestjs/outbox": ">=0.1.4 <0.2.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-notifications-core": "workspace:^",
    "@nestjs/common": "12.3.2",
    "reflect-metadata": "0.2.2",
    "typescript": "5.9.3",
    "@nestjs/webhooks": "0.0.4",
    "@nestjs/outbox": "0.1.4",
    "@nestjs/core": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "rxjs": "7.8.2"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependenciesMeta": {
    "@nestjs/outbox": {
      "optional": true
    }
  }
}
