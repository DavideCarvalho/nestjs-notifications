{
  "name": "@dudousxd/nestjs-notifications-resilience",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-notifications.git",
    "directory": "packages/resilience"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/notifications",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-notifications/issues"
  },
  "keywords": [
    "nestjs",
    "notifications",
    "resilience"
  ],
  "description": "Provider failover for nestjs-notifications — per-provider circuit breaker + per-attempt timeout (from @nestjs/resilience) + ordered failover",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/resilience": ">=0.0.3 <0.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/resilience": "0.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  }
}
