{
  "name": "@dudousxd/nestjs-notifications-database-drizzle",
  "version": "0.0.0",
  "description": "Drizzle ORM (Postgres) adapter for the nestjs-notifications database channel",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-notifications.git",
    "directory": "packages/database-drizzle"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/notifications",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-notifications/issues"
  },
  "keywords": [
    "nestjs",
    "notifications",
    "database",
    "drizzle",
    "drizzle-orm",
    "postgres"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-notifications-database": ">=0.1.0 <1.0.0",
    "@dudousxd/nestjs-notifications-preferences": ">=0.1.0 <1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "drizzle-orm": ">=0.40.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-notifications-preferences": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-notifications-core": "workspace:^",
    "@dudousxd/nestjs-notifications-database": "workspace:^",
    "@dudousxd/nestjs-notifications-preferences": "workspace:^",
    "@electric-sql/pglite": "0.4.6",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@testcontainers/postgresql": "10.18.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "typescript": "5.9.3"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
