{
  "name": "nestjs-notifications-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Laravel-style notifications for NestJS",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-notifications.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:exports": "node scripts/check-package-exports.mjs --all",
    "build": "turbo run build --filter=!website",
    "build:docs": "pnpm --filter website build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "turbo run typecheck --filter=!website",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!website && pnpm check:exports && pnpm check:package && changeset publish",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.16.22",
    "@testcontainers/mysql": "10.18.0",
    "@testcontainers/postgresql": "10.18.0",
    "@types/node": "24.19.2",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "tsup": "8.5.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "2.1.9"
  }
}
